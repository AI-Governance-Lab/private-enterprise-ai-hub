# =============================================================================
# Network, Ports & Storage Configuration (Home LAN / Local Access)
# =============================================================================
DOCKER_NETWORK=private-ai-net
OPEN_WEBUI_BIND_IP=0.0.0.0
OPEN_WEBUI_PORT=8080
LITELLM_BIND_IP=0.0.0.0
LITELLM_PORT=4000
LITELLM_AGENTS_BIND_IP=0.0.0.0
LITELLM_AGENTS_PORT=4001
TIKA_BIND_IP=127.0.0.1
TIKA_PORT=9998
CAD_SERVICE_ENABLED=1
DATA_STORAGE_PATH=/mnt/raid1/podman-volumes/open-webui-data

# =============================================================================
# Cloud Credentials & API Keys (NEVER commit your real .env file)
# =============================================================================
GCP_CREDENTIALS_FILE=credentials.json
GCP_PROJECT_ID=your-gcp-project-id
WEBUI_SECRET_KEY=replace_with_a_secure_random_string
LITELLM_MASTER_KEY=replace_with_a_secure_random_string
MISTRAL_API_KEY=your_mistral_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
